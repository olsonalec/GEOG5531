   "source": [
    "# Import Packages & Libraries\n",
    "\n",
    "from pysal.explore import esda # For exploratory data analysis of spatial data\n",
    "\n",
    "# Analysis Libraries\n",
    "\n",
    "import numpy as np # For working with Arrays\n",
    "import pandas as pd # Data Manipulation\n",
    "import geopandas as gpd # Spatial Data Manipulation\n",
    "from pysal.lib import weights # Spatial Weights Objects\n",
    "from splot.esda import plot_moran, moran_scatterplot, lisa_cluster # Moran's I\n",
    "\n",
    "# Visualization Libraries\n",
    "\n",
    "import matplotlib.pyplot as plt # Basic Plotting\n",
    "import seaborn as sns # Statistical Plotting\n",
    "import contextily # Base Map Visualization\n",
    "\n",
    "import warnings # silence because there will be a lot of warnings\n",
