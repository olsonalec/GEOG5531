   "outputs": [],
   "source": [
    "# add a new column to the GeoDataFrame that will store info about which voting district each block group becomes a part of\n",
    "census_block_group_data['VOTINGDISTRICT'] = list(np.zeros(len(census_block_group_data)))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 611,
   "id": "5d87ff9c-a8cf-4bb0-ba65-dc42f4f66edd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "713311\n"
     ]
    }
   ],
   "source": [
    "# Find total population of Minnesota, then calculate the size of each voting district.\n",
    "# Minnesota has 8 districts, and we want each of them to be as close to 1/8th the total population as possible.\n",
    "\n",
    "mn_total_pop = sum(census_block_group_data['POPTOTAL'])\n",
    "voting_district_size = int(mn_total_pop / 8)\n",
    "\n",
    "print(voting_district_size)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "65480a77-31d7-43ed-8200-6487f0abfb08",
   "metadata": {},
   "source": [
    "### Define function to build a district using a greedy search algorithm\n",
    "\n",
    "The function takes a starting block group and builds a voting district one block group at a time. From the neighbors of the starting block group, the algorithm chooses the neighboring block group that is most similar - this is determined based on the variables of interest from above:\n",
    "1. % of population older than 65\n",
    "2. Average household size\n",
    "3. Median age\n",
    "4. Hispanic population as a percentage of total population\n",
    "5. % of population with an annual income > $100,000\n",
    "\n",
    "For example, if the starting block group was classified using the Local Moran's I as high-high for variables $1$ and $3$ above, then the algorithm will try to find a neighboring block group that was also classified as high-high for variables $1$ and/or $3$. This is a rudimentary way to try and keep similarly-attributed block groups together while building voting districts.\n",
    "\n",
    "The algorithm runs until it has built a district with a population greater than the `voting_district_size` parameter from above, and then it moves onto building the next district, and so on.\n",
    "\n",
    "#### Parameters:\n",
    "- `census_dataframe`: the GeoDataFrame containing all the Census data\n",
    "- `starting_block`: an integer index into the `census_dataframe` telling the algorithm where to start building a district\n",
    "- `population_target`: the goal size of each voting district\n",
    "- `district_number`: an integer from 1-8 telling the algorithm which voting district it is currently building"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 613,
   "id": "cdaf8eb4-b267-4ed7-b036-10a3d54c2beb",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_district(census_dataframe, starting_block, population_target, district_number):\n",
    "    queue = []\n",
    "    queue.append(starting_block)\n",
    "    census_dataframe.iloc[starting_block].VOTINGDISTRICT = district_number\n",
    "    \n",
    "    starting_block_population = census_dataframe.iloc[starting_block].POPTOTAL\n",
    "    \n",
    "    current_population = starting_block_population  # the current size of the voting district\n",
    "    \n",
    "    while current_population < population_target:\n",
    "        block = queue.pop(0)\n",
    "        # find the neighbors of the current block group\n",
    "        current_block_group = census_dataframe.iloc[block]\n",
    "        neighbors = census_dataframe[census_dataframe.geometry.touches(current_block_group.geometry)]   # find neighbors of current Block Group\n",
    "        \n",
    "        pct_pop_over_65 = current_block_group.POPOVER65PCT\n",
    "        avg_household_size = current_block_group.AVGHHSIZE\n",
    "        median_age = current_block_group.MEDIANAGE\n",
    "        pct_hispanic_pop = current_block_group.HISPPOPPCT\n",
    "        pct_high_income_pop = current_block_group.HIGHINCOMEPOPPCT\n",
    "        \n",
    "        best_neighbor_index = -1\n",    # an index into the GeoDataFrame for the neighbor with the highest score
    "        best_neighbor_score = -1\n",    # the highest score for a neighboring block group; points are earned if a neighbor has a similar high-high or low-low value for a given variable compared to the current block group
    "        for j in range(len(neighbors)):\n",
    "            # make sure to only consider neighbors that are not already part of a voting district\n",
    "            if neighbors.iloc[j].VOTINGDISTRICT == 0:\n",
    "                \n",
    "                '''\n",
    "                The problem is that, if we're not careful, the algorithm will happily build voting districts that contain holes.\n",
    "                i.e. There will be a block group in the center that is completely surrounded by the voting district but is not part of the district itself.\n",
    "                To avoid this problem, we will override the normal scoring criteria whenever the algorithm finds itself in this situation.\n",
    "                '''\n",
    "\n",
    "                neighbors_of_neighbor = census_dataframe[census_dataframe.geometry.touches(neighbors.iloc[j].geometry)]   # find neighbors of current Block Group\n",
    "\n",
    "                check = True\n",
    "\n",
    "                # Check to see if the surrounding block groups are all part of the same district.\n",
    "                # If they are, there is a hole and we need to fill it.\n",
    "                for k in range(len(neighbors_of_neighbor)):\n",
    "                    if neighbors_of_neighbor.iloc[k].VOTINGDISTRICT != district_number:\n",
    "                        check = False\n",
    "                if check == True:\n",
    "                    # if check is True, then all the neighboring block groups are part of the same voting district\n",
    "                    score = 1000\n",
    "                else:\n",
    "                    score = 0\n",
    "                \n",
    "                neighbor_pct_pop_over_65 = neighbors.iloc[j].POPOVER65PCT\n",
    "                neighbor_avg_household_size = neighbors.iloc[j].AVGHHSIZE\n",
    "                neighbor_median_age = neighbors.iloc[j].MEDIANAGE\n",
    "                neighbor_pct_hispanic_pop = neighbors.iloc[j].HISPPOPPCT\n",
    "                neighbor_pct_high_income_pop = neighbors.iloc[j].HIGHINCOMEPOPPCT\n",
    "\n",
    "                if pct_pop_over_65 == neighbor_pct_pop_over_65:\n",
    "                    score += 1\n",
    "                if avg_household_size == neighbor_avg_household_size:\n",
    "                    score += 1\n",
    "                if median_age == neighbor_median_age:\n",
    "                    score += 1\n",
    "                if pct_hispanic_pop == neighbor_pct_hispanic_pop:\n",
    "                    score += 1\n",
    "\n",
    "                if score > best_neighbor_score:\n",
    "                    best_neighbor_score = score\n",
    "                    best_neighbor_index = neighbors.index[j]\n",
    "        \n",
    "        # If the algorithm chose a block group that was completely surrounded by the already-created voting district, then we cannot use this block group for the next iteration.\n",
    "        # The reason for this is that it will not find any suitable neighbors because all the neighbors are already part of the voting district.\n",
    "        # Therefore, we have to find another block group for the next iteration that is part of this district but has neighbors that have not been assigned a voting district yet.\n",
    "        if best_neighbor_index == -1:\n",
    "            for item in census_dataframe.itertuples():\n",
    "                if item.VOTINGDISTRICT == district_number:    # check only the block groups in the GeoDataFrame that are a part of this voting district\n",
    "                    neighbors = census_dataframe[census_dataframe.geometry.touches(item.geometry)]\n",
    "                    for l in range(len(neighbors)):\n",
    "                        if neighbors.iloc[l].VOTINGDISTRICT == 0:\n",
    "                            # we have found a block group in the voting district that has at least one neighboring block group that isn't in a district yet\n",
    "                            best_neighbor_index = neighbors.index[l]\n",
    "                            break\n",
    "        \n",
    "        if best_neighbor_index == -1:\n",
    "            # in this case, the entire voting district is surrounded by other districts;\n",
    "            # this should hopefully only happen when constructing the final district,\n",
    "            # so it functions as a terminating condition for this function if the district's population is less than the goal population\n",
    "            break\n",
    "                            \n",
    "        current_population += census_dataframe.iloc[best_neighbor_index].POPTOTAL\n",
    "        census_dataframe.iloc[best_neighbor_index, census_dataframe.columns.get_loc('VOTINGDISTRICT')] = district_number\n",
    "\n",
    "        queue.append(best_neighbor_index)\n",
    "    \n",
    "    # after building a voting district, we need to find a new block group (that is neighboring the current voting district) to starting building the next district\n",
    "    for m in range(len(census_dataframe['VOTINGDISTRICT'])):\n",
    "        if census_dataframe['VOTINGDISTRICT'][m] == 0:\n",
    "            return m\n",
    "    # for item in census_dataframe.itertuples():            \n",
    "        # if item.VOTINGDISTRICT == district_number:\n",
    "            # neighbors = census_dataframe[census_dataframe.geometry.touches(item.geometry)]\n",
    "            # for m in range(len(neighbors)):\n",
    "                # if neighbors.iloc[m].VOTINGDISTRICT == 0:\n",
    "                    # we have found a block group that isn't yet part of any district\n",
    "                    # return neighbors.index[m]\n",
    "    \n",
    "    # if we get here, then we can't build any more districts\n",
    "    return -1"
   ]
  },
