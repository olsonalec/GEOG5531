    "\n",
    "pd.set_option('display.max_columns',None)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "58de6f5a",
   "metadata": {},
   "source": [
    "### Import U.S. Census data for Hennepin County, MN\n",
    "\n",
    "Data source: https://catalog.data.gov/dataset/2024-cartographic-boundary-file-shp-block-group-for-minnesota-1-500000"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 602,
   "id": "90804466",
   "metadata": {},
   "outputs": [],
   "source": [
    "census_block_group_data = gpd.read_file(\"mn_2020_census_block_groups.geojson\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bf66c9ac-5837-46c1-ba91-1dde88096cda",
   "metadata": {},
   "source": [
    "Data source: https://data.census.gov/table?q=Income+(Households,+Families,+Individuals)&g=040XX00US27$1500000"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 603,
   "id": "90fc0c81-d762-4aff-9de4-a1524c04cf2a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Join income data table to the GeoDataFrame\n",
    "\n",
    "income = pd.read_csv(\"ACSDT5Y2024.B19001-Data.csv\")\n",
    "\n",
    "census_block_group_data = census_block_group_data.merge(income, how='left', on='GEOIDFQ')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6aac9ed5-7896-476e-a238-2c80c036585b",
   "metadata": {},
   "source": [
    "### Create a new column for % of population over 65 years of age"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 604,
   "id": "37588811-6382-4d41-87db-8c99e4621b0e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def generate_new_population_column(column_1, column_2):\n",
    "    new_column = np.array(column_1) / np.array(column_2)\n",
    "    \n",
    "    # check for nan values\n",
    "    for i in range(len(new_column)):\n",
    "        if np.isnan(new_column[i]):\n",
    "            new_column[i] = 0\n",
    "    \n",
    "    return new_column"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 605,
   "id": "e5ede1c9-d208-4d45-ab3b-a21c78524d17",
   "metadata": {},
   "outputs": [],
   "source": [
    "old_pop = census_block_group_data['POPOVER65']\n",
    "hisp_pop = census_block_group_data['HISPPOP']\n",
    "total_pop = census_block_group_data['POPTOTAL']\n",
    "\n",
    "old_pop_pct = generate_new_population_column(old_pop, total_pop)\n",
    "hisp_pop_pct = generate_new_population_column(hisp_pop, total_pop)\n",
    "        \n",
    "census_block_group_data['POPOVER65PCT'] = old_pop_pct\n",
    "census_block_group_data['HISPPOPPCT'] = hisp_pop_pct"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3244bdb7-a535-4f18-a403-72708d5a115c",
   "metadata": {},
   "source": [
    "### Create a new column for % of population earning > $100,000 per year"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 606,
   "id": "6758927d-20b2-4140-a02d-2439c645ddd8",
   "metadata": {},
   "outputs": [],
   "source": [
    "pop = census_block_group_data['Estimate!!Total:']\n",
    "a = census_block_group_data['Estimate!!Total:!!$100,000 to $124,999']\n",
    "b = census_block_group_data['Estimate!!Total:!!$125,000 to $149,999']\n",
    "c = census_block_group_data['Estimate!!Total:!!$150,000 to $199,999']\n",
    "d = census_block_group_data['Estimate!!Total:!!$200,000 or more']\n",
    "\n",
    "percentages = []\n",
    "for i in range(len(pop)):\n",
    "    if pop[i] == 0:\n",
    "        percentages.append(0)\n",
    "    else:\n",
    "        percentages.append((a[i] + b[i] + c[i] + d[i]) / pop[i])\n",
    "\n",
    "census_block_group_data['HIGHINCOMEPOPPCT'] = percentages"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "21000ba8-131c-4e40-9486-26f27df0663a",
   "metadata": {},
   "source": [
    "### Identify statistically significant quadrants using Local Moran's I"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 607,
   "id": "9728c4f2-f021-4568-ba2b-2f55639a9b0e",
   "metadata": {},
   "outputs": [],
   "source": [
    "interest_vars = ['POPOVER65PCT', 'AVGHHSIZE', 'MEDIANAGE', 'HISPPOPPCT', 'HIGHINCOMEPOPPCT']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 608,
   "id": "f8d38da3-dc33-4a74-b456-1008b9a7da62",
   "metadata": {},
   "outputs": [],
   "source": [
    "w_queen = weights.Queen.from_dataframe(census_block_group_data)  # create a Queens weights object\n",
    "w_queen.transform = 'R'   # row standardize\n",
    "\n",
    "p_value = 0.05\n",
    "\n",
    "for i in range(len(interest_vars)):\n",
    "\n",
    "    local_moran = esda.Moran_Local(y=census_block_group_data[interest_vars[i]], w=w_queen)\n",
    "    new_var_name = f'{interest_vars[i]}_MORAN_QUADRANTS'\n",
    "    \n",
    "    # use these lines to classify only the quadrants that are statistically significant (using the p-value from above)\n",
    "    labels = []\n",
    "    for j in range(len(local_moran.q)):\n",
    "        if ((local_moran.p_sim[j] < p_value) and (local_moran.q[j] == 1)):\n",
    "            labels.append('High-High')\n",
    "        elif ((local_moran.p_sim[j] < p_value) and (local_moran.q[j] == 3)):\n",
    "            labels.append('Low-Low')\n",
    "        else:\n",
    "            labels.append('N/A')\n",
    "    census_block_group_data[new_var_name] = labels"
   ]
  },
